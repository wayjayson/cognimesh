{
  "name": "cognimesh",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "cd server && node index.js",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install --include=dev",
    "build": "cd client && npm run build",
    "start": "cd server && NODE_ENV=production node index.js",
    "seed-admin": "cd server && node scripts/seed-admin.js"
  }
}
