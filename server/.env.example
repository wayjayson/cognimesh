# ===========================================
# CogniMesh 配置文件
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ===========================================

# 服务器端口
PORT=5000

# MongoDB 连接字符串 (MongoDB Atlas 或本地)
# Atlas 格式: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cognimesh?retryWrites=true&w=majority
# 本地格式: mongodb://127.0.0.1:27017/cognimesh
MONGODB_URI=mongodb://127.0.0.1:27017/cognimesh

# JWT 密钥 — 使用以下命令生成:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
REFRESH_SECRET=your_refresh_secret_here

# DeepSeek API 配置
# 注册地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# 前端地址 (开发环境)
CLIENT_URL=http://localhost:5173

# 环境模式 (production | development)
NODE_ENV=development
